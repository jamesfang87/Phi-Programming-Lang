extend bool with Eq { fun eq(&self, other: &Self) -> bool { return core::llvm::eq(*self, *other); } }

extend bool with Comparable { fun less_than(&self, other: &Self) -> bool { return core::llvm::less_than(*self, *other); } }

extend char with Eq { fun eq(&self, other: &Self) -> bool { return core::llvm::eq(*self, *other); } }

extend char with Comparable { fun less_than(&self, other: &Self) -> bool { return core::llvm::less_than(*self, *other); } }
