module core::ops;

public trait Add<Rhs> {
    fun add(&self, other: &Rhs) -> Self;
}

public trait Sub {
    fun sub(&self, other: &Self) -> Self;
}

public trait Mul {
    fun mul(&self, other: &Self) -> Self;
}

public trait Div {
    fun div(&self, other: &Self) -> Self;
}

public trait Rem {
    fun rem(&self, other: &Self) -> Self;
}

public trait Neg {
    fun neg(&self) -> Self;
}

public trait Not {
    fun not(&self) -> Self;
}

public trait Eq {
    fun eq(&self, other: &Self) -> bool;
}

public trait Comparable {
    fun less_than(&self, other: &Self) -> bool;
}

public trait Index<K, V> {
    fun index(&self, key: K) -> &V;
}

public trait IndexSet<K, V> {
    fun index_set(&mut self, key: K, value: V);
}

public trait Drop {
    fun drop(self);
}

public trait Copy {
    fun copy(&self) -> Self;
}

extend i8 with Add<i8> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend i16 with Add<i16> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend i32 with Add<i32> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend i64 with Add<i64> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend u8 with Add<u8> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend u16 with Add<u16> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend u32 with Add<u32> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend u64 with Add<u64> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend usize with Add<usize> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend f32 with Add<f32> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }
extend f64 with Add<f64> { fun add(&self, other: &Self) -> Self { return core::llvm::add(*self, *other); } }

